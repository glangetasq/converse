DATABASE_URL=postgresql://postgres:postgres@localhost:5432/convo_maker
PORT=3000
# Applies backend/sql/*.sql as DDL on startup. Keep false in prod (schema loaded out-of-band).
AUTO_CREATE_TABLES=true
ALLOWED_ORIGINS=http://localhost:3000,chrome-extension://*
LOCAL_DEV_USER_EMAIL=local-dev@convo-maker.test

# Bearer shared-secret gate for /api/*. Unset = off (local dev); required in prod.
CONVERSE_API_KEY=

# Default model served by GET /api/llm/models.
DEFAULT_MODEL=claude-haiku-4-5-20251001

# Provider keys. From env/.env; for local dev: `source scripts/load_secrets.sh`.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com
ANTHROPIC_API_KEY=
ANTHROPIC_VERSION=2023-06-01
CLAUDE_API_BASE_URL=https://api.anthropic.com

# Self-hosted vLLM models (OpenAI chat-completions). Model ids: hosted/<served-name>.
HOSTED_API_BASE_URL=http://localhost:8000
HOSTED_API_KEY=
HOSTED_API_TIMEOUT_SECONDS=
# served-name=url pairs for models on separate vLLM services; unlisted fall back to HOSTED_API_BASE_URL.
HOSTED_MODEL_BASE_URLS=
